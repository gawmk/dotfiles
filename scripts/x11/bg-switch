#!/bin/bash

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
[ -f "$DOTFILES/hosts/$(hostname).sh" ] && . "$DOTFILES/hosts/$(hostname).sh"
WPDIR="${WALLPAPER_DIR:-$HOME/sync/media/pics/wallpapers}/"


font="IosevkaComfy Nerd Font:size=14:weight=semibold"
DMENUCMD=(dmenu -fn "$font" -l 10 -c)


image=$(ls $WPDIR | "${DMENUCMD[@]}")

[[ -z $image ]] && exit 0

feh --bg-scale "$WPDIR/$image"



